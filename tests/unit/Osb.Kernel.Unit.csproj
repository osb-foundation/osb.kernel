<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-side unit tests for the freestanding Program Registry (M1.2).
       Links the REAL kernel sources (EmbeddedRegistry.cs +
       EmbeddedRegistry.Leases.cs) so the tests exercise the actual
       implementation, not a mock. Only the kernel/allocator boundary
       (Kernel.OsAlloc/OsFree, Layout, NativeMethods user-stub symbols) is
       stubbed, because the Registry is freestanding kernel code that cannot
       run under the host BCL/physical allocator directly. No QEMU, no
       NativeAOT: runs in <1 s. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OsbKernelUnit</AssemblyName>
    <RootNamespace>Osb.Kernel.Unit</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8603;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Processes/EmbeddedRegistry.cs" Link="Processes/EmbeddedRegistry.cs" />
    <Compile Include="../../Processes/EmbeddedRegistry.Leases.cs" Link="Processes/EmbeddedRegistry.Leases.cs" />
    <Compile Include="../../Processes/PidAllocator.cs" Link="Processes/PidAllocator.cs" />
    <Compile Include="../../Processes/Ipc.cs" Link="Processes/Ipc.cs" />
    <Compile Include="../../Processes/Ipc.Registry.cs" Link="Processes/Ipc.Registry.cs" />
    <Compile Include="../../Processes/Ipc.Publish.cs" Link="Processes/Ipc.Publish.cs" />
    <Compile Include="../../Processes/Ipc.Deliver.cs" Link="Processes/Ipc.Deliver.cs" />
    <Compile Include="../../Processes/Ipc.Cleanup.cs" Link="Processes/Ipc.Cleanup.cs" />
    <Compile Include="../../Memory/PhysicalMemory.cs" Link="Memory/PhysicalMemory.cs" />
    <Compile Include="../../Sync/SpinLock.cs" Link="Sync/SpinLock.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="SpinLockTests.cs" />
    <Compile Include="AllocatorTests.cs" />
    <Compile Include="PidAllocatorTests.cs" />
    <Compile Include="IpcTests.cs" />
    <Compile Include="IpcTestAccess.cs" />
    <Compile Include="Stubs/Kernel.cs" />
    <Compile Include="Stubs/Layout.cs" />
    <Compile Include="Stubs/NativeMethods.cs" />
    <Compile Include="RegistryTestReset.cs" />
  </ItemGroup>

</Project>
