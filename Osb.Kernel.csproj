<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <AssemblyName>OsbKernel</AssemblyName>

    <!-- Boot program source (H-B): default always boots SHELL.EXE. When
         BootFromConf=true (set by build.sh with WITH_TESTS=1), the kernel
         also honors A:\OSB\CONF/BOOT so golden cases can boot a test program
         directly. The default image ignores CONF/BOOT even if present. -->
    <BootFromConf>false</BootFromConf>

    <!-- This is not .NET: it is a freestanding NativeAOT kernel compiled against
         our own mini-CoreLib (MiniCoreLib.cs). No BCL, no runtime. -->
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefineConstants>$(DefineConstants);TARGET_64BIT</DefineConstants>
    <DefineConstants Condition="'$(BootFromConf)' == 'true'">$(DefineConstants);BOOT_FROM_CONF</DefineConstants>
  </PropertyGroup>

  <!-- mini-CoreLib sources: link the canonical copies from osb.core
       (sibling checkout, see README.md). osb.core split the original single
       MiniCoreLib.cs into per-topic files (PrimitiveTypes.cs holds UInt32/
       IntPtr/etc., CompilerSupport.cs the compiler-required attributes), so
       every src/*.cs file must be linked or the predefined types disappear.
       The glob keeps this in sync with ../osb.core/src automatically. -->
  <ItemGroup>
    <Compile Include="../osb.core/src/*.cs" Link="osb.core/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Host-side test sources (tests/unit) must not be compiled into the
       freestanding kernel: they link the registry sources directly and their
       stub allocator/layout/native-symbol types would collide with the real
       kernel types. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <!-- Fail with a clear message when the sibling repo is missing (A10). -->
  <Target Name="CheckSiblings" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../osb.core/src/MiniCoreLib.cs')"
           Text="osb.core sibling repo not found (expected ../osb.core/src/MiniCoreLib.cs). Clone the OSB repos side by side; see README.md." />
  </Target>

  <!-- The project file pretends this is .NET, but it is not. Remove every
       assembly reference the .NET SDK added (matches the zerosharp samples). -->
  <Target Name="CustomizeReferences" BeforeTargets="BeforeCompile" AfterTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" />
      <ReferencePath Remove="@(ReferencePath)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveHostConfigurationOptions" BeforeTargets="WriteIlcRspFileForCompilation" DependsOnTargets="PrepareForILLink">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="@(RuntimeHostConfigurationOption)" />
    </ItemGroup>
  </Target>

</Project>
